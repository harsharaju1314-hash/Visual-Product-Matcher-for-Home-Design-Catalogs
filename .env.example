# Database Configuration
DATABASE_URL=postgresql://cyncly_user:cyncly_password@localhost:5432/product_catalog_db

# Application Configuration
APP_NAME=Visual Product Matcher for Home-Design Catalogs
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Image Processing Limits (5 MB limit)
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# Model Configuration
MODEL_NAME=resnet18
EMBEDDING_DIM=512
DEFAULT_TOP_K=5
